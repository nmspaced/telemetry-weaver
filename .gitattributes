# Keep the Composer dist archive to what an application runs: src/, config/, docs and the
# license. Everything below is development tooling or the test suite.
/.devcontainer          export-ignore
/.github                export-ignore
/.idea                  export-ignore
/tests                  export-ignore
/.gitattributes         export-ignore
/.gitignore             export-ignore
/.php-cs-fixer.dist.php export-ignore
/compose.yaml           export-ignore
/igor.json              export-ignore
/igor-baseline.json     export-ignore
/mago.toml              export-ignore
/phpstan.neon.dist      export-ignore
/phpunit.xml.dist       export-ignore
/rector.php             export-ignore
