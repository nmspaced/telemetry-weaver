# PHP-FPM, or FrankenPHP with FRANKENPHP_RESET_KERNEL=1: a new pipeline for every request.
# Bundle settings: fpm.yaml. Collector: collector.yaml.

OTEL_SERVICE_NAME=orders-api
OTEL_RESOURCE_ATTRIBUTES=service.namespace=backend,deployment.environment.name=production

# Weaver builds the providers; the SDK must not build a second set.
OTEL_PHP_AUTOLOAD_ENABLED=false
OTEL_PROPAGATORS=tracecontext,baggage

OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none

# A collector next to PHP (same host, or a sidecar): every request exports after its response,
# and the FPM child is busy until that is done. ext-protobuf makes the encoding much cheaper.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# Each child's service.instance.id is derived from the SDK's process and host detectors, which
# the default OTEL_PHP_DETECTORS=all includes. OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE
# does not apply here: request pipelines always export counters and histograms as delta.
