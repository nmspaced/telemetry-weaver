# OTLP/HTTP per-signal endpoints are used as-is: include /v1/<signal>.
# Different scheme://host:port origins are independent Weaver budget destinations.
# Different paths on the same origin share one destination budget.

OTEL_SERVICE_NAME=orders-api
OTEL_PHP_AUTOLOAD_ENABLED=false
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://tempo:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://mimir:4318/v1/metrics
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://loki:4318/v1/logs

# Signal-specific timeout overrides are supported by OTLP.
OTEL_EXPORTER_OTLP_TRACES_TIMEOUT=500
OTEL_EXPORTER_OTLP_METRICS_TIMEOUT=500
OTEL_EXPORTER_OTLP_LOGS_TIMEOUT=500
