# Workers that keep their kernel: FrankenPHP worker mode, RoadRunner, messenger:consume.
# Bundle settings: worker.yaml. Collector: collector.yaml.
# A custom RoadRunner bootstrap must expose the runtime mode: APP_RUNTIME_MODE=web=1&worker=1

OTEL_SERVICE_NAME=orders-api
OTEL_RESOURCE_ATTRIBUTES=service.namespace=backend,deployment.environment.name=production

# Weaver builds the providers; the SDK must not build a second set.
OTEL_PHP_AUTOLOAD_ENABLED=false
OTEL_PROPAGATORS=tracecontext,baggage

OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none

OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# How often a request boundary may export: spans every second, metrics every 15 seconds.
# Each export happens at the end of some request, after its response.
OTEL_BSP_SCHEDULE_DELAY=1000
OTEL_METRIC_EXPORT_INTERVAL=15000

# Metrics are cumulative per worker, each with its own service.instance.id. Delta also works if
# the backend or collector takes it:
# OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
